          <defs>
          <filter id="filter0_f_1_38" x="0.673065" y="0.323547" width="69.0625" height="250.529" filterUnits="userSpaceOnUse" color-interpolation-filters="sRGB">
          <feFlood flood-opacity="0" result="BackgroundImageFix"/>
          <feBlend mode="normal" in="SourceGraphic" in2="BackgroundImageFix" result="shape"/>
          <feGaussianBlur stdDeviation="1" result="effect1_foregroundBlur_1_38"/>
          </filter>
          </defs>
        </svg>                 
      {% endif %}
        <img class="product-modal__body-image" src="{{ product.featured_image.src | img_url: '900x900' }}" alt="{{ product.featured_image.alt }}" style="max-width: {{ max_height | times: product.featured_image.aspect_ratio }}px;" loading="lazy">
    </div>
    {% if product.handle == 'apollo-city-pro-22-scooter' %}
      <div class="product-modal__parts-wrapper hide">
        <div class="product-modal__parts-wrapper-body">
          <p class="product-modal__parts-wrapper-heading">Parts</p>
          <ul class="product-modal__parts-list">
            {% for product in collections["parts"].products %}
              {% if product.available %}
                <li class="product-modal__parts hide" data-id="{{ product.first_available_variant.id }}">
                  <p class="product-modal__parts-details">{{ product.title }} - <span class="product-modal__parts-price">{{ product.price | money }}</span></p>
                  <button class="product-modal__parts-remove">x</button>
                </li>
              {% endif %}
            {% endfor %}
          </ul>   
          <button class="product-modal__parts-checkout-btn">Add to bag</button>
        </div>
      </div>
    {% endif%}
  </div>
</div>